<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Photogen</AssemblyName>
    <RootNamespace>Photogen</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Photogen</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- one self-contained exe, no .NET install needed on the target PC -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <!-- the web UI is embedded into the exe; resource name = path relative to the project root -->
  <ItemGroup>
    <EmbeddedResource Include="..\index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="..\css\**\*" LogicalName="web/css/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\js\**\*" LogicalName="web/js/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
